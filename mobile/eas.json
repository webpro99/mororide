{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.0.201:8000/api",
        "EXPO_PUBLIC_REVERB_HOST": "192.168.0.201",
        "EXPO_PUBLIC_REVERB_PORT": "8080",
        "EXPO_PUBLIC_REVERB_SCHEME": "http",
        "EXPO_PUBLIC_REVERB_APP_KEY": "mororide-local-key"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
