APP_NAME=MoroRide
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mororide.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Filled by https://mororide.com/install
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mororide
DB_USERNAME=mororide
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=public
SANCTUM_STATEFUL_DOMAINS=mororide.com,www.mororide.com

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=mororide-production
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=mororide.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://mororide.com,https://www.mororide.com

# Configure securely later from Admin > Payment Settings.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_POINTS_MIN_TOPUP=20
STRIPE_POINTS_MAX_TOPUP=5000
STRIPE_POINTS_PER_CURRENCY_UNIT=0.66666667

EXPO_PUSH_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@mororide.com
MAIL_FROM_NAME=MoroRide

