APP_NAME=MoroRide
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mororide
DB_USERNAME=mororide
DB_PASSWORD=mororide

# `reverb` delivers the private-channel events implemented by the API.
# Use `log` for payload diagnostics or `null` to disable broadcasting.
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Expo push delivery (mobile notifications). Best-effort; set false to disable.
EXPO_PUSH_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe is opt-in so cash rides/local demos work without external calls.
# Use sk_test_/pk_test_ first; never expose STRIPE_SECRET_KEY to mobile/web.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_CURRENCY=mad
STRIPE_POINTS_MIN_TOPUP=20
STRIPE_POINTS_MAX_TOPUP=5000
STRIPE_POINTS_PER_CURRENCY_UNIT=1

# Connect onboarding/payout accounts. Enable only after the platform business
# and connected-account country are supported and approved by Stripe.
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_COUNTRY=
STRIPE_CONNECT_REFRESH_URL=http://localhost:8081/payments/connect/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:8081/payments/connect/return

REVERB_APP_ID=mororide-local
REVERB_APP_KEY=mororide-local-key
REVERB_APP_SECRET=change-this-in-every-non-local-environment
# Laravel publishes events to this address. In Docker use `reverb`; when
# running everything directly on the host use `127.0.0.1`.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Production: a comma-separated allow-list, never `*`.
REVERB_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
